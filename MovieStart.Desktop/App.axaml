<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MovieStart.Desktop.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#18794E" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://MovieStart.Desktop/Styles/AppStyles.axaml" />
  </Application.Styles>
</Application>
