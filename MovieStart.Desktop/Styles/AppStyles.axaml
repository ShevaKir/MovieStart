<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Palette: ground #F6F5F2, surface white, line #E4E2DD, text #1C1B19, muted #6E6A63, accent #18794E. -->

  <!-- Text -->
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="#6E6A63" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="#C0392B" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Buttons: one size, centered content, hover and pressed states for every kind. -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#D6D3CC" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#1C1B19" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F1EFEB" />
    <Setter Property="BorderBrush" Value="#C2BEB5" />
    <Setter Property="Foreground" Value="#1C1B19" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#E4E2DD" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- Main action: green. -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="#18794E" />
    <Setter Property="BorderBrush" Value="#18794E" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#13603E" />
    <Setter Property="BorderBrush" Value="#13603E" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#0F4F33" />
  </Style>

  <!-- Destructive confirmation. -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="#C0392B" />
    <Setter Property="BorderBrush" Value="#C0392B" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#A93226" />
    <Setter Property="BorderBrush" Value="#A93226" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Square icon button. -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Small borderless icon button for dense lists (episodes). -->
  <Style Selector="Button.mini">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="#45433F" />
  </Style>
  <Style Selector="Button.mini:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#E6F4EC" />
    <Setter Property="Foreground" Value="#13603E" />
  </Style>

  <!-- List row that lights up under the pointer. -->
  <Style Selector="Border.row">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.row:pointerover">
    <Setter Property="Background" Value="#F6F5F2" />
  </Style>

  <!-- Borderless button on a surface: remote transport, list actions. -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,0" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#EEEDE9" />
  </Style>

  <!-- Text link. -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Foreground" Value="#18794E" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#0F4F33" />
  </Style>
  <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.link.muted">
    <Setter Property="Foreground" Value="#6E6A63" />
  </Style>
  <Style Selector="Button.link.muted:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="#1C1B19" />
  </Style>

  <!-- Round play/pause on the remote. -->
  <Style Selector="Button.play">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Background" Value="#1C1B19" />
    <Setter Property="BorderBrush" Value="#1C1B19" />
    <Setter Property="Foreground" Value="#F6F5F2" />
  </Style>
  <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#3A3833" />
    <Setter Property="BorderBrush" Value="#3A3833" />
    <Setter Property="Foreground" Value="#F6F5F2" />
  </Style>

  <!-- Sidebar navigation. -->
  <Style Selector="Button.nav">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="#6E6A63" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F6F5F2" />
    <Setter Property="Foreground" Value="#1C1B19" />
  </Style>
  <Style Selector="Button.nav.selected">
    <Setter Property="Background" Value="#EEEDE9" />
    <Setter Property="Foreground" Value="#1C1B19" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.nav.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#EEEDE9" />
  </Style>

  <!-- Poster card: no grey fill on hover, the poster gets a green frame instead. -->
  <Style Selector="Button.poster">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.poster:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.poster:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Highlight ring drawn on top of the poster with the same radius, so corners stay clean. -->
  <Style Selector="Border.poster-ring">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.poster:pointerover Border.poster-ring">
    <Setter Property="BorderBrush" Value="#18794E" />
  </Style>
  <Style Selector="Button.poster:pointerover TextBlock.poster-title">
    <Setter Property="Foreground" Value="#13603E" />
  </Style>

  <!-- Filter chips. -->
  <Style Selector="ToggleButton.chip">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#D6D3CC" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F1EFEB" />
    <Setter Property="BorderBrush" Value="#C2BEB5" />
    <Setter Property="Foreground" Value="#1C1B19" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#E6F4EC" />
    <Setter Property="BorderBrush" Value="#18794E" />
    <Setter Property="Foreground" Value="#13603E" />
  </Style>
  <Style Selector="ToggleButton.chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#D5ECDF" />
  </Style>

  <!-- Inputs share the button height. -->
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Surfaces. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#E4E2DD" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.tag">
    <Setter Property="Background" Value="#EEEDE9" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="7,3" />
  </Style>
  <Style Selector="Border.tag.preferred">
    <Setter Property="Background" Value="#E6F4EC" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="#EEEDE9" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="#E4E2DD" />
  </Style>
  <Style Selector="Ellipse.status">
    <Setter Property="Fill" Value="#6E6A63" />
  </Style>
  <Style Selector="Ellipse.status.online">
    <Setter Property="Fill" Value="#18794E" />
  </Style>
  <Style Selector="Ellipse.status.offline">
    <Setter Property="Fill" Value="#C0392B" />
  </Style>
</Styles>
