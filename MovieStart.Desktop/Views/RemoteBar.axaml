<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MovieStart.Desktop.ViewModels"
             x:Class="MovieStart.Desktop.Views.RemoteBar"
             x:DataType="vm:PlayerViewModel">
  <!-- Two rows so it fits narrow windows: what plays, transport and tracks; then the timeline. -->
  <Border Background="White" BorderBrush="#E4E2DD" BorderThickness="0,1,0,0" Padding="24,12,24,14">
    <StackPanel Spacing="6" IsEnabled="{Binding IsConnected}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="20">
        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="muted" FontSize="12" Text="On TV" IsVisible="{Binding HasMedia}" />
          <TextBlock Classes="muted" FontSize="12" Text="Player is not running" IsVisible="{Binding !IsConnected}" />
          <TextBlock Classes="error" FontSize="12" Text="{Binding Error}" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsEnabled="{Binding HasMedia}">
          <Button Classes="ghost" Command="{Binding SeekBackCommand}" ToolTip.Tip="Back 30 seconds">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <PathIcon Data="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z" Width="16" Height="16" />
              <TextBlock Text="30" VerticalAlignment="Center" FontSize="13" />
            </StackPanel>
          </Button>
          <Button Classes="play" Command="{Binding TogglePauseCommand}" ToolTip.Tip="Play / pause">
            <Panel>
              <PathIcon Data="M8 5v14l11-7z" Width="18" Height="18" IsVisible="{Binding IsPaused}" />
              <PathIcon Data="M6 4h4v16H6z M14 4h4v16h-4z" Width="18" Height="18" IsVisible="{Binding !IsPaused}" />
            </Panel>
          </Button>
          <Button Classes="ghost" Command="{Binding SeekForwardCommand}" ToolTip.Tip="Forward 30 seconds">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="30" VerticalAlignment="Center" FontSize="13" />
              <PathIcon Data="M12 5V1l5 5-5 5V7c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6h2c0 4.42-3.58 8-8 8s-8-3.58-8-8 3.58-8 8-8z" Width="16" Height="16" />
            </StackPanel>
          </Button>
          <Button Classes="ghost icon" Command="{Binding StopCommand}" ToolTip.Tip="Stop">
            <PathIcon Data="M6 6h12v12H6z" Width="14" Height="14" />
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsEnabled="{Binding HasMedia}">
          <ComboBox Width="170" ItemsSource="{Binding AudioTracks}" SelectedItem="{Binding SelectedAudioTrack}"
                    PlaceholderText="Audio" ToolTip.Tip="Audio track" />
          <ComboBox Width="130" ItemsSource="{Binding SubtitleTracks}" SelectedItem="{Binding SelectedSubtitleTrack}"
                    PlaceholderText="Subtitles" ToolTip.Tip="Subtitles" />
          <PathIcon Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"
                    Width="16" Height="16" Foreground="#6E6A63" />
          <Slider Width="90" Minimum="0" Maximum="100" Value="{Binding Volume}" VerticalAlignment="Center" ToolTip.Tip="Volume" />
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" IsEnabled="{Binding HasMedia}">
        <TextBlock Grid.Column="0" Classes="muted" FontSize="12" Text="{Binding PositionText}" VerticalAlignment="Center" MinWidth="44" />
        <Slider Grid.Column="1" Minimum="0" Maximum="{Binding SeekMaximum}" Value="{Binding Position}" />
        <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Text="{Binding DurationText}" VerticalAlignment="Center" MinWidth="44"
                   TextAlignment="Right" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
