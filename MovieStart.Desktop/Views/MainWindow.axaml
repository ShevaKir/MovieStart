<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MovieStart.Desktop.ViewModels"
        xmlns:views="using:MovieStart.Desktop.Views"
        x:Class="MovieStart.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MovieStart"
        Icon="/Assets/icon.png"
        Width="1200" Height="800" MinWidth="960" MinHeight="600"
        Background="#F6F5F2">
  <DockPanel>
    <views:RemoteBar DockPanel.Dock="Bottom" DataContext="{Binding Player}" />

    <!-- Sidebar -->
    <Border DockPanel.Dock="Left" Width="232" Background="White" BorderBrush="#E4E2DD" BorderThickness="0,0,1,0" Padding="14,20">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="14" Margin="8,0">
          <StackPanel Spacing="8" DataContext="{Binding Library}" x:DataType="vm:LibraryViewModel">
            <TextBlock Classes="muted" FontSize="12" Text="{Binding StorageText}" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding StorageUsedPercent}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                     Classes="status"
                     Classes.online="{Binding IsOnline}"
                     Classes.offline="{Binding IsOffline}" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="24">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,0">
            <!-- Logo: play button inside a download ring; source in Assets/logo.svg -->
            <Viewbox Width="26" Height="26">
              <Canvas Width="100" Height="100">
                <Rectangle Width="100" Height="100" RadiusX="22" RadiusY="22" Fill="#18794E" />
                <Ellipse Canvas.Left="21" Canvas.Top="21" Width="58" Height="58" Stroke="#47FFFFFF" StrokeThickness="7" />
                <Path Data="M 50,21 A 29,29 0 1 1 21,50" Stroke="White" StrokeThickness="7" StrokeLineCap="Round" />
                <Path Data="M 44,39 L 44,61 L 62,50 Z" Fill="White" Stroke="White" StrokeThickness="4" StrokeJoin="Round" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="MovieStart" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Spacing="2">
            <Button Classes="nav" Classes.selected="{Binding IsSearchSection}" Command="{Binding ShowSearchCommand}" Content="Search" />
            <Button Classes="nav" Classes.selected="{Binding IsLibrarySection}" Command="{Binding ShowLibraryCommand}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Library" />
                <TextBlock Grid.Column="1" Text="{Binding Library.Items.Count}" FontSize="12" Classes="muted" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="nav" Classes.selected="{Binding IsSettingsSection}" Command="{Binding ShowSettingsCommand}" Content="Settings" />
            <Button Classes="nav" Classes.selected="{Binding IsDemoSection}" Command="{Binding ShowDemoCommand}" IsVisible="{Binding IsDemo}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Demo" />
                <Border Grid.Column="1" Classes="tag" Background="#FCEFD9" VerticalAlignment="Center">
                  <TextBlock Text="test" FontSize="11" Foreground="#9A5B00" />
                </Border>
              </Grid>
            </Button>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Content -->
    <Panel>
      <!-- Visibility sits on a wrapper so it binds to the window, while the view binds to its own view model. -->
      <Panel IsVisible="{Binding IsSearchSection}">
        <views:SearchView DataContext="{Binding Search}" />
      </Panel>
      <Panel IsVisible="{Binding IsLibrarySection}">
        <views:LibraryView DataContext="{Binding Library}" />
      </Panel>
      <views:SettingsView IsVisible="{Binding IsSettingsSection}" />
      <views:DemoView IsVisible="{Binding IsDemoSection}" />
    </Panel>
  </DockPanel>
</Window>
