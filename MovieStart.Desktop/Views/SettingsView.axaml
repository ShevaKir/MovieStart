<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MovieStart.Desktop.ViewModels"
             x:Class="MovieStart.Desktop.Views.SettingsView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer>
    <StackPanel Margin="32,28" Spacing="24" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Classes="h1" Text="Settings" />

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Agent address" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding AgentUrl}" PlaceholderText="http://sheva-server.local:5080" />
            <Button Grid.Column="1" Content="Check" Command="{Binding CheckConnectionCommand}" />
          </Grid>
          <TextBlock Text="For local development run the agent on this Mac and use http://localhost:5080."
                     Classes="muted" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card" DataContext="{Binding VoiceProfile}" x:DataType="vm:VoiceProfileViewModel">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Voice-over profile" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="Best first. Releases with these voice-overs are listed first, and playback picks the matching audio track. Studio is optional, e.g. HDRezka or LostFilm." />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Preferences}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:VoicePreferenceRowViewModel">
                <Grid ColumnDefinitions="140,150,*,Auto" ColumnSpacing="8">
                  <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" />
                  <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" />
                  <TextBox Grid.Column="2" Text="{Binding Studio}" PlaceholderText="Any studio" />
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                    <Button Classes="icon" Command="{Binding MoveUpCommand}" ToolTip.Tip="Move up">
                      <PathIcon Data="M7.41 15.41 12 10.83l4.59 4.58L18 14l-6-6-6 6z" Width="14" Height="14" />
                    </Button>
                    <Button Classes="icon" Command="{Binding MoveDownCommand}" ToolTip.Tip="Move down">
                      <PathIcon Data="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z" Width="14" Height="14" />
                    </Button>
                    <Button Classes="icon" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove">
                      <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                Width="12" Height="12" />
                    </Button>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Add preference" Command="{Binding AddCommand}" />
            <Button Classes="ghost" Content="Reset to default" Command="{Binding ResetToDefaultCommand}" />
          </StackPanel>

          <Border Classes="divider" />

          <StackPanel Spacing="8">
            <TextBlock Text="Subtitles when the audio is in another language" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding SubtitleLanguages}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="20" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SubtitleLanguageViewModel">
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="With a dub, only forced subtitles (signs, foreign lines) in the dub's language are shown." />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Classes="accent" Content="Save profile" Command="{Binding SaveCommand}" />
            <TextBlock Text="{Binding Status}" Foreground="#18794E" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Error}" Classes="error" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
